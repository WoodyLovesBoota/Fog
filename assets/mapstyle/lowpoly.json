{
  "version": 8,
  "name": "Fog Lowpoly",
  "metadata": {
    "fog:note": "Forked from Stadia alidade_smooth. Labels/POIs/boundaries/railways stripped; colors come from src/config/lowpolyPalette.ts (PALETTE is the single source of truth — keep hexes in sync). {STADIA_API_KEY} is substituted at runtime by mapConfig.ts."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "scheme": "xyz",
      "url": "https://tiles.stadiamaps.com/data/openmaptiles.json?api_key={STADIA_API_KEY}"
    }
  },
  "glyphs": "https://tiles.stadiamaps.com/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.stadiamaps.com/styles/alidade-smooth/sprite",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EFE7D3"
      }
    },
    {
      "id": "park_fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["==", "$type", "Polygon"],
      "paint": {
        "fill-color": "#A8D5A2"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 10,
      "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "wood"]],
      "paint": {
        "fill-color": "#8FC489",
        "fill-opacity": { "base": 1, "stops": [[10, 0], [12, 1]] }
      }
    },
    {
      "id": "landcover_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 10,
      "filter": ["all", ["==", "$type", "Polygon"], ["==", "subclass", "park"]],
      "paint": {
        "fill-color": "#A8D5A2",
        "fill-opacity": { "base": 1, "stops": [[10, 0], [12, 1]] }
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": {
        "fill-antialias": true,
        "fill-color": { "stops": [[10, "#6BBBDA"], [12, "#7EC8E3"]] }
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#7EC8E3",
        "line-width": { "base": 1.3, "stops": [[13, 1], [18, 4]] }
      }
    },
    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "minor", "service", "track"]
      ],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#C7C2B4",
        "line-width": { "base": 1.55, "stops": [[13, 2.5], [18, 11]] }
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"]
      ],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#C7C2B4",
        "line-width": { "base": 1.4, "stops": [[5.8, 0], [6, 3], [12, 4.5], [20, 32]] }
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "minor", "service", "track"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#DBD6CA",
        "line-width": { "base": 1.55, "stops": [[13, 1], [18, 8]] }
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E8E3D6",
        "line-width": { "base": 1.4, "stops": [[4, 1.5], [6, 1.3], [12, 3], [20, 28]] }
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "filter": ["==", "$type", "Polygon"],
      "paint": {
        "fill-extrusion-color": "#F6F1E5",
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0,
          14,
          ["coalesce", ["get", "render_height"], 8]
        ],
        "fill-extrusion-vertical-gradient": false
      }
    }
  ]
}
